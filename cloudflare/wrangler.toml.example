name = "dispatchos-auth-api"
main = "src/router.ts"
compatibility_date = "2026-08-01"

[vars]
ALLOWED_ORIGINS = "https://redavi19-asu.github.io,http://localhost:3000"
ADMIN_EMAIL = "YOUR_ADMIN_EMAIL_HERE"
PUBLIC_APP_ORIGIN = "https://redavi19-asu.github.io/icomputer-dispatch-platform"
# Secrets required for recovery/social auth:
# RESEND_API_KEY
# ICA_AUTH_FROM_EMAIL
# SOCIAL_GOOGLE_CLIENT_ID / SOCIAL_GOOGLE_CLIENT_SECRET
# SOCIAL_APPLE_CLIENT_ID / SOCIAL_APPLE_CLIENT_SECRET
# SOCIAL_MICROSOFT_CLIENT_ID / SOCIAL_MICROSOFT_CLIENT_SECRET

[[d1_databases]]
binding = "DB"
database_name = "dispatchos"
database_id = "PASTE_D1_DATABASE_ID_HERE"
